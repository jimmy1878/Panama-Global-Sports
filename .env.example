# Copiar a .env.local y completar. En Vercel: Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer al cliente ni usar con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# API de Claude para crónicas (console.anthropic.com → API Keys). Solo servidor.
ANTHROPIC_API_KEY=

# Notificaciones Web Push (generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Protege las rutas de cron de Vercel (cadena aleatoria larga). Solo servidor.
CRON_SECRET=

# Solo para generar tipos (npm run db:types). Token personal de
# https://supabase.com/dashboard/account/tokens — da acceso a tu cuenta: nunca subirlo.
SUPABASE_ACCESS_TOKEN=
